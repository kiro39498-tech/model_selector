# AI Application Architect — environment configuration (PLACEHOLDERS ONLY)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- AI endpoint (OpenAI-compatible) ---
AI_BASE_URL=http://indiaai.maqsoftware.net/v1
AI_MODEL=qwen3.8-27b
AI_API_KEY=your-ai-api-key-here

# --- Neon PostgreSQL ---
# Example form: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Application ---
# Comma-separated list of allowed origins for CORS. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:5173
# Secret used to sign/verify internal tokens if needed later.
APP_SECRET=change-me-in-production
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Model classification policy (application convention, not a scientific definition) ---
# A model with fewer than this many parameters is an SLM; >= this is an LLM.
CLASSIFICATION_THRESHOLD_BILLIONS=150
